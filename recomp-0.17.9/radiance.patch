new file mode 100644
index 0000000000000000000000000000000000000000..faf4b19da502aa553ac817513f0f4b4474c337b3
--- /dev/null
+++ b/runtime/nvn/vulkan/radiance_glsl.inc
@@ -0,0 +1,64 @@
+"// uv follows the scene texture; all pulse centres use the same orientation.\n"
+"// control: centre.xy, age in seconds, peak strength. Zero strength is idle.\n"
+"vec3 radiance_taps(sampler2D scene, vec2 uv, vec4 draw, vec4 contact, vec4 fan) {\n"
+"    if (max(draw.w, max(contact.w, fan.w)) <= 0.0)\n"
+"        return texture(scene, uv).rgb;\n"
+"\n"
+"    float aspect = float(textureSize(scene, 0).x) / float(textureSize(scene, 0).y);\n"
+"    vec2 displacement = vec2(0.0);\n"
+"    vec2 blur = vec2(0.0);\n"
+"    float fan_flash = 0.0;\n"
+"    vec4 pulses[3] = vec4[3](draw, contact, fan);\n"
+"    for (int i = 0; i < 3; ++i) {\n"
+"        vec4 pulse = pulses[i];\n"
+"        if (pulse.w <= 0.0) continue;\n"
+"        float duration = i == 1 ? 0.70 : 0.20;\n"
+"        float age = clamp(pulse.z / duration, 0.0, 1.0);\n"
+"        bool impact = i == 1;\n"
+"        float envelope = pulse.w * (1.0 - smoothstep(0.03, 1.0, age));\n"
+"        vec2 delta = (uv - pulse.xy) * vec2(aspect, 1.0);\n"
+"        float distance = length(delta);\n"
+"        vec2 axis = delta / max(distance, 0.025);\n"
+"        float expansion = impact ? 1.0 - pow(1.0 - age, 2.4) : smoothstep(0.0, 0.95, age);\n"
+"        float radius = mix(impact ? 0.026 : 0.058, impact ? 0.29 : 0.31, expansion);\n"
+"        float width = impact ? 0.045 : 0.066;\n"
+"        float band = 1.0 - smoothstep(0.0, width, abs(distance - radius));\n"
+"        float core = smoothstep(0.006, 0.09, distance)\n"
+"                   * (1.0 - smoothstep(0.08, impact ? 0.36 : 0.43, distance));\n"
+"        // A compression ridge followed by an opposite distortion on its inner edge.\n"
+"        float crest = band * clamp((distance - radius) / (width * 0.55), -1.0, 1.0);\n"
+"        displacement += axis * crest * envelope * (impact ? 0.024 : 0.019);\n"
+"        float smear = max(core, band * 0.72) * envelope;\n"
+"        blur += axis * smear * (impact ? 0.036 : 0.041);\n"
+"        if (i == 2) {\n"
+"            // The soft burst shares the damage frame with the distortion.\n"
+"            fan_flash = (1.0 - smoothstep(0.012, 0.077, distance))\n"
+"                      * (1.0 - smoothstep(0.0, 0.31, age)) * 0.22;\n"
+"        }\n"
+"    }\n"
+"    vec2 inverse_aspect = vec2(1.0 / aspect, 1.0);\n"
+"    // Leave the screen borders and their static HUD controls outside the shock.\n"
+"    vec2 edge = min(uv, vec2(1.0) - uv);\n"
+"    float mask = smoothstep(0.12, 0.22, edge.x) * smoothstep(0.12, 0.22, edge.y);\n"
+"    displacement *= mask;\n"
+"    blur *= mask;\n"
+"    vec2 warped = uv + displacement * inverse_aspect;\n"
+"    vec2 taps = blur * inverse_aspect;\n"
+"    float flash = fan_flash * mask;\n"
+"    if (dot(displacement, displacement) + dot(blur, blur) < 0.00000001)\n"
+"        return mix(texture(scene, uv).rgb, vec3(1.0, 0.63, 0.48), flash);\n"
+"\n"
+"    vec3 sampled = texture(scene, warped).rgb * 0.28\n"
+"                 + (texture(scene, warped - taps * 0.48).rgb + texture(scene, warped + taps * 0.48).rgb) * 0.25\n"
+"                 + (texture(scene, warped - taps).rgb + texture(scene, warped + taps).rgb) * 0.11;\n"
+"    return mix(sampled, vec3(1.0, 0.63, 0.48), flash);\n"
+"}\n"
+"\n"
+"\n"
+"vec3 radiance_scene(sampler2D scene, vec2 uv, vec4 draw, vec4 contact, vec4 fan, float compare) {\n"
+"    if (compare > 0.5) {\n"
+"        if (uv.x < 0.5) return texture(scene, vec2(uv.x*2.0, uv.y)).rgb;\n"
+"        uv.x = uv.x*2.0-1.0;\n"
+"    }\n"
+"    return radiance_taps(scene, uv, draw, contact, fan);\n"
+"}\n"
